# Copy to .env and fill in. NEVER commit .env.

# --- Supabase (public values; also set on Railway) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Only for legacy projects signing JWTs with HS256 (leave empty for JWKS/ES256 projects)
SUPABASE_JWT_SECRET=

# --- Local only: used by scripts/load_data.py. NEVER set this on Railway. ---
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Gate checks (scripts/gate.py) ---
LIVE_URL=https://your-app.up.railway.app
GATE_USER_EMAIL=team.member@example.com
GATE_USER_PASSWORD=change-me

APP_ENV=dev
